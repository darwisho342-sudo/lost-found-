# The current MVP uses local SQLite only.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000
SQLITE_PATH=db.sqlite3

# Local University MVP identity and access rules.
UNIVERSITY_NAME=Demo University
UNIVERSITY_EMAIL_DOMAINS=student.demo.edu,staff.demo.edu
UNIVERSITY_CAMPUSES=Main Campus
UNIVERSITY_SECURITY_OFFICE=University Lost and Found Office
INTERNATIONAL_MODE_ENABLED=True
SESSION_COOKIE_AGE=259200
ITEM_RETENTION_DAYS=90

# Optional email. The default console backend keeps local development functional.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=FindMatch <no-reply@localhost>

MEDIA_ROOT=media
PRIVATE_MEDIA_ROOT=private_media
STATIC_ROOT=staticfiles
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
# Enable only after every subdomain is permanently HTTPS-ready.
SECURE_HSTS_PRELOAD=0
