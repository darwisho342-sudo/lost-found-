# Local development uses SQLite when DB_ENGINE is not set.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SQLITE_PATH=db.sqlite3

# PostgreSQL production example (set DB_ENGINE=postgresql to enable).
DB_ENGINE=sqlite
DB_NAME=findmatch
DB_USER=findmatch
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# Optional email. The default console backend keeps local development functional.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=FindMatch <no-reply@localhost>

# Optional map. Manual international location fields always remain available.
MAP_ENABLED=0
MAP_PROVIDER=
MAP_PUBLIC_BROWSER_KEY=

MEDIA_ROOT=media
PRIVATE_MEDIA_ROOT=private_media
STATIC_ROOT=staticfiles
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
# Enable only after every subdomain is permanently HTTPS-ready.
SECURE_HSTS_PRELOAD=0
